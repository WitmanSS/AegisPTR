# Application settings
APP_NAME=AegisPTR
APP_ENV=production
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=aegis_ptr
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://replace-with-db-user:replace-with-long-random-password@postgres:5432/aegis_ptr

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# AI settings
AI_PROVIDER=disabled
AI_MODEL=llama3.2
AI_BASE_URL=http://ollama:11434
AI_API_KEY=
# AI is optional. Use provider `ollama` or `openai-compatible` to enable model analysis.

# Security
SECRET_KEY=replace-with-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Tool configuration
NMAP_BIN=nmap
NUCLEI_BIN=nuclei
ZAP_BIN=zaproxy

# Logging
LOG_LEVEL=INFO

# Optional initial administrator; remove after first bootstrap if preferred.
ADMIN_USER=admin
ADMIN_PASS=replace-with-long-admin-password

# Docker / local startup
COMPOSE_PROJECT_NAME=aegisptr
