# Application settings
APP_NAME=AegisPTR
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_password
POSTGRES_DB=aegis_ptr
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aegis:aegis_password@postgres:5432/aegis_ptr

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# AI settings
AI_PROVIDER=disabled
AI_MODEL=llama3.2
AI_BASE_URL=http://localhost:11434
AI_API_KEY=

# Security
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Tool configuration
NMAP_BIN=nmap
NUCLEI_BIN=nuclei
ZAP_BIN=zaproxy

# Logging
LOG_LEVEL=INFO

# Docker / local startup
COMPOSE_PROJECT_NAME=aegisptr
